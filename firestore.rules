rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Sitio estático: el cliente solo LEE los comandos publicados en /biblioteca.
    // Nadie escribe desde la web ni desde la API; el contenido se gestiona desde la consola de Firebase
    // (la consola y el Admin SDK no pasan por estas reglas).
    match /commands/{commandId} {
      allow read: if true;
      allow write: if false;
    }

    // Flujo de propuestas retirado: la colección ya no recibe ni expone nada.
    match /commandProposals/{proposalId} {
      allow read, write: if false;
    }

    match /admins/{userId} {
      allow read, write: if false;
    }

    // Todo lo demás, denegado explícitamente.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
